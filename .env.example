# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (app LLM calls go here only)
NEBIUS_API_KEY=

# Storage
DATA_DIR=./data
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Credit controls and limits
RUN_TOKEN_BUDGET=
DAILY_TOKEN_CAP=
MAX_CONCURRENCY=4
RATE_LIMIT_PER_HOUR=20
